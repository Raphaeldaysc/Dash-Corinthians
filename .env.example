# Copie para .env e preencha. Todas as chaves sao opcionais: sem elas o dash usa so a ESPN.

# https://dashboard.api-football.com (plano free: 100 requisicoes/dia)
API_FOOTBALL_KEY=

# https://www.football-data.org/client/register (plano free: 10 requisicoes/min, so Brasileirao)
FOOTBALL_DATA_KEY=

# Upstash Redis (https://console.upstash.com, plano free). Legado/opcional.
# No fluxo recomendado (ETL local + Vercel estática), deixe vazio: os dados ficam no PC e o JSON gerado vai pelo Git.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Temporadas analisadas (separadas por virgula). A maior e tratada como temporada atual.
SEASONS=2024,2025,2026

# Meta de aproveitamento usada na linha de referencia do grafico de pontos (0 a 1)
TARGET_RATE=0.60
